# engstack — biến môi trường. Copy: cp .env.example .env
# `.env` KHÔNG được commit (đã có trong .gitignore). `docker compose` tự đọc file này.

# ---------------------------------------------------------------------------
# Self-host local (`make selfhost`) — Postgres + Go API + web nginx.
# ---------------------------------------------------------------------------
# Cổng web trên máy host: http://localhost:5199
WEB_PORT=5199
# Mật khẩu Postgres trong container (chỉ dùng nội bộ stack local).
POSTGRES_PASSWORD=postgrespassword
# Ký access token. Local dùng giá trị mặc định được; đổi khi mở stack ra LAN.
JWT_SECRET=dev-insecure-secret-key-change-in-prod
# false = bắt buộc Google OAuth thật (đúng với self-host). true = nhận token "dev:<email>".
AUTH_DEV_MODE=false

# ---------------------------------------------------------------------------
# Frontend → Go API. Vite inline các biến này LÚC BUILD, nên đổi giá trị phải
# build/deploy lại. `npm run dev` và `npm run build` tự đọc file `.env`.
# ---------------------------------------------------------------------------
# Same-origin mặc định (dev proxy `/api` → localhost:8080, prod nginx → api:8080).
VITE_API_BASE_URL=/api/v1
# Bắt buộc: `make selfhost`/`docker compose up` fail-fast nếu rỗng, và backend dùng
# chính giá trị này làm GOOGLE_CLIENT_ID. Phải thêm origin vào Google Cloud Console:
#   Authorized JavaScript origins → http://localhost:5199 (và http://localhost:5173 khi dev)
VITE_GOOGLE_CLIENT_ID=831458581259-kfvimrc12uqsfnflj35grqo948cei7no.apps.googleusercontent.com
# Bump thủ công mỗi lần seed dữ liệu thay đổi: query `?v=` đổi nên browser không
# chờ hết `max-age` 24h của `GET /topics`.
VITE_CONTENT_VERSION=local

# ---------------------------------------------------------------------------
# Pipeline dữ liệu — chỉ dùng cho `npm run data:translate` (điền meaning/exampleVi).
# Export trước khi chạy: set -a && . ./.env && set +a && npm run data:translate
# ---------------------------------------------------------------------------
TRANSLATE_BASE_URL=https://9router.hvantoan.xyz/v1
TRANSLATE_MODEL=flash
TRANSLATE_API_KEY=
TRANSLATE_CONCURRENCY=6
