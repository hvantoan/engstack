# LLM dùng cho `npm run data:translate` (điền meaning/exampleVi tiếng Việt).
# Copy file này thành .env rồi export trước khi chạy, ví dụ:
#   set -a && . ./.env && set +a && npm run data:translate
TRANSLATE_BASE_URL=https://9router.hvantoan.xyz/v1
TRANSLATE_MODEL=flash
TRANSLATE_API_KEY=
TRANSLATE_CONCURRENCY=6
