# engstack backend — template biến môi trường.
# App KHÔNG tự đọc file .env; copy rồi export trước khi chạy:
#   cp .env.example .env && set -a && . ./.env && set +a && go run ./cmd/api
# `make run` / `make seed` chỉ cần DATABASE_URL (có default trỏ host port 5433).
# Không bao giờ commit secret thật.
PORT=8080
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5433/engstack?sslmode=disable
# Production: chuỗi ngẫu nhiên, KHÔNG dùng giá trị dev này.
JWT_SECRET=dev-insecure-secret-key-change-in-prod
# Client ID thật khi tắt AUTH_DEV_MODE.
GOOGLE_CLIENT_ID=831458581259-kfvimrc12uqsfnflj35grqo948cei7no.apps.googleusercontent.com
# true = chấp nhận token "dev:<email>" (chỉ local; production phải false).
AUTH_DEV_MODE=true
# Origin được phép CORS khi FE chạy khác origin (same-origin qua nginx thì không cần).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Chạy migration lúc khởi động.
MIGRATE_ON_BOOT=true
